# Copy to .env (backend) and frontend/.env.local (frontend), then fill in.

# --- Steward AI agent (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Hard latency budget for an advisory card; falls back to the rule engine if exceeded
STEWARD_LATENCY_BUDGET_MS=2000

# --- Data ---
OPENF1_BASE_URL=https://api.openf1.org/v1
REPLAY_DATA_DIR=../data

# --- API ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Serve contract fixtures from data/mocks instead of the real engine (frontend dev)
MOCK_MODE=0

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
